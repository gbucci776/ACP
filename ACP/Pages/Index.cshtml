@page
@model IndexModel
@{
    ViewData["Title"] = "Portal Access";
}

<div class="py-5">
    <div class="text-center mb-5">
        <p class="text-uppercase text-muted small fw-semibold mb-2">
            ACP Secure Access
        </p>

        <p class="lead text-muted">
            Staging Environment for Atlanta Collections Partners
        </p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column p-4">
                    <h2 class="h4">
                        Admin Portal
                    </h2>

                    <p class="text-muted flex-grow-1">
                        Access user management, agency settings,
                        reporting, uploaded customer documents, and administrative
                        functions.
                    </p>

                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       asp-route-returnUrl="/admin/users"
                       class="btn btn-dark w-100">
                        Admin Sign In
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column p-4">
                    <h2 class="h4">
                        Client Portal
                    </h2>

                    <p class="text-muted flex-grow-1">
                        Submit delinquent collection documents, upload supporting
                        files if needed, and review our account activity (collection reporting status to be manually updated).
                    </p>

                    <a asp-page="/Client/Login"
                       class="btn btn-primary w-100">
                        Client Sign In
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column p-4">
                    <h2 class="h4">
                        Account Resolution Portal
                    </h2>

                    <p class="text-muted flex-grow-1">
                        Consumers/Customers can securely review their account & outstanding balance with the root client and access available
                        payment or resolution options. Will access their account with File# and temporary password OR secure-access link provided in email.
                    </p>

                    <a asp-page="/Consumer/Login"
                       class="btn btn-outline-primary w-100">
                        Continue to My Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>