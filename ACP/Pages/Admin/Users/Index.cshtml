@page "/admin/users"
@model ACP.Pages.Admin.Users.IndexModel

@{
    ViewData["Title"] = "User Management";
}

<div class="admin-page">

    <header class="admin-page-header">
        <div>
            <span class="admin-eyebrow">ADMINISTRATION</span>

            <h1>User Management</h1>

            <p>
                Manage staff, client, and consumer portal access.
            </p>
        </div>

        <div class="admin-header-actions">
            <span class="admin-count-badge">
                <strong>@Model.Users.Count</strong>
                account@(Model.Users.Count == 1 ? "" : "s")
            </span>

            <a href="#"
               class="admin-primary-button">
                <span aria-hidden="true">+</span>
                Add User
            </a>
        </div>
    </header>

    <section class="admin-summary-grid">
        <article class="admin-summary-card">
            <span>Total Accounts</span>
            <strong>@Model.Users.Count</strong>
            <small>All registered portal users</small>
        </article>

        <article class="admin-summary-card">
            <span>Active Accounts</span>
            <strong>@Model.Users.Count(user => user.IsActive)</strong>
            <small>Users permitted to sign in</small>
        </article>

        <article class="admin-summary-card">
            <span>Client Users</span>
            <strong>@Model.Users.Count(user => user.IsClientUser)</strong>
            <small>Users connected to client portals</small>
        </article>

        <article class="admin-summary-card">
            <span>Unconfirmed Email</span>
            <strong>@Model.Users.Count(user => !user.EmailConfirmed)</strong>
            <small>Accounts requiring confirmation</small>
        </article>
    </section>

    <section class="admin-table-card">
        <div class="admin-table-header">
            <div>
                <h2>Registered Accounts</h2>

                <p>
                    Review account access, company assignments, and activity.
                </p>
            </div>

            <div class="admin-search-wrapper">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m21 19-5.2-5.2A7 7 0 1 0 14 15.8L19 21l2-2ZM5 10a5 5 0 1 1 10 0 5 5 0 0 1-10 0Z" />
                </svg>

                <input type="search"
                       id="userSearch"
                       placeholder="Search users..."
                       aria-label="Search users" />
            </div>
        </div>

        @if (Model.Users.Count == 0)
        {
            <div class="admin-empty-state">
                <div class="admin-empty-icon">A</div>

                <h3>No accounts found</h3>

                <p>
                    Registered staff, client, and consumer accounts will
                    appear here.
                </p>
            </div>
        }
        else
        {
            <div class="admin-table-responsive">
                <table class="admin-user-table" id="userTable">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Company</th>
                            <th>Roles</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Last Login</th>
                            <th class="admin-actions-heading">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var initials =
                            $"{user.FirstName.FirstOrDefault()}{user.LastName.FirstOrDefault()}"
                            .ToUpperInvariant();

                            <tr>
                                <td>
                                    <div class="admin-user-identity">
                                        <span class="admin-user-avatar">
                                            @(string.IsNullOrWhiteSpace(initials)
                                                ? "U"
                                                : initials)
                                        </span>

                                        <div>
                                            <strong>@user.DisplayName</strong>
                                            <span>@user.Email</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(user.CompanyName))
                                    {
                                        <span class="admin-muted-value">
                                            Not assigned
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="admin-company-cell">
                                            <strong>@user.CompanyName</strong>

                                            @if (user.ClientOrganizationId.HasValue)
                                            {
                                                <span>
                                                    Client #@user.ClientOrganizationId
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="admin-role-list">
                                        @if (user.Roles.Count == 0)
                                        {
                                            <span class="admin-muted-value">
                                                No role
                                            </span>
                                        }
                                        else
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="admin-role-badge">
                                                    @role
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="admin-status active">
                                            <span></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status disabled">
                                            <span></span>
                                            Disabled
                                        </span>
                                    }
                                </td>

                                <td>
                                    <time datetime="@user.CreatedUtc.ToString("O")">
                                        @user.CreatedUtc
                                        .ToLocalTime()
                                        .ToString("MMM d, yyyy")
                                    </time>
                                </td>

                                <td>
                                    @if (user.LastLoginUtc.HasValue)
                                    {
                                        <time datetime="@user.LastLoginUtc.Value.ToString("O")">
                                            @user.LastLoginUtc.Value
                                            .ToLocalTime()
                                            .ToString("MMM d, yyyy")
                                        </time>

                                        <span class="admin-table-subtext">
                                            @user.LastLoginUtc.Value
                                            .ToLocalTime()
                                            .ToString("h:mm tt")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-muted-value">
                                            Never
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="admin-row-actions">
                                        @if (user.IsClientUser
                                       && user.IsActive
                                       && user.ClientOrganizationId.HasValue)
                                        {
                                            <form method="post"
                                                  asp-page-handler="Impersonate"
                                                  class="admin-inline-form">

                                                <input type="hidden"
                                                       name="userId"
                                                       value="@user.Id" />

                                                <button type="submit"
                                                        class="admin-preview-button"
                                                        title="Preview this client's portal">
                                                    View Portal
                                                </button>
                                            </form>
                                        }

                                        <a asp-page="./Details"
                                           asp-route-id="@user.Id"
                                           class="admin-manage-button">
                                            Manage
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const input = document.getElementById("userSearch");
            const table = document.getElementById("userTable");

            if (!input || !table) {
                return;
            }

            const rows = table.querySelectorAll("tbody tr");

            input.addEventListener("input", () => {
                const searchValue =
                    input.value.trim().toLowerCase();

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();

                    row.hidden =
                        searchValue.length > 0
                        && !text.includes(searchValue);
                });
            });
        })();
    </script>
}