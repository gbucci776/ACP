@page "/admin/users"
@model ACP.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">User Management</h1>
        <p class="text-muted mb-0">
            View registered staff, client, and consumer accounts.
        </p>
    </div>

    <div>
        <span class="badge bg-secondary fs-6">
            @Model.Users.Count account@(Model.Users.Count == 1 ? "" : "s")
        </span>
    </div>
</div>

@if (Model.Users.Count == 0)
{
    <div class="alert alert-info">
        No registered accounts were found.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Roles</th>
                        <th scope="col">Status</th>
                        <th scope="col">Email</th>
                        <th scope="col">Created</th>
                        <th scope="col">Last login</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    @user.DisplayName
                                </div>

                                <div class="small text-muted">
                                    ID: @user.Id
                                </div>
                            </td>

                            <td>
                                @if (user.Roles.Count == 0)
                                {
                                    <span class="text-muted">
                                        No role assigned
                                    </span>
                                }
                                else
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-primary me-1 mb-1">
                                            @role
                                        </span>
                                    }
                                }
                            </td>

                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Disabled
                                    </span>
                                }
                            </td>

                            <td>
                                <div>@user.Email</div>

                                @if (user.EmailConfirmed)
                                {
                                    <span class="small text-success">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="small text-warning">
                                        Not confirmed
                                    </span>
                                }
                            </td>

                            <td>
                                <time datetime="@user.CreatedUtc.ToString("O")">
                                    @user.CreatedUtc.ToLocalTime()
                                    .ToString("MMM d, yyyy")
                                </time>
                            </td>

                            <td>
                                @if (user.LastLoginUtc.HasValue)
                                {
                                    <time datetime="@user.LastLoginUtc.Value.ToString("O")">
                                        @user.LastLoginUtc.Value
                                        .ToLocalTime()
                                        .ToString("MMM d, yyyy h:mm tt")
                                    </time>
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </td>

                            <td class="text-end">
                                <a asp-page="./Details"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Manage
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}