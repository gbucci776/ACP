@page "/client"
@model ACP.Pages.Client.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="client-dashboard">

    <!-- Mobile sidebar overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar -->
    <aside class="client-sidebar" id="clientSidebar">

        <div class="sidebar-header">
            <a asp-page="/Client/Index" class="client-brand">
                <span class="brand-mark">A</span>

                <span class="brand-copy">
                    <strong>ACP</strong>
                    <small>Client Portal</small>
                </span>
            </a>

            <button class="sidebar-close"
                    id="sidebarClose"
                    type="button"
                    aria-label="Close navigation">
                &times;
            </button>
        </div>

        <div class="sidebar-client-card">
            <div class="client-avatar">
                @Model.CompanyInitials
            </div>

            <div class="client-identity">
                <span>Signed in as</span>
                <strong>@Model.CompanyName</strong>
            </div>
        </div>

        <nav class="sidebar-navigation" aria-label="Client navigation">

            <p class="navigation-label">Workspace</p>

            <a asp-page="/Client/Index"
               class="sidebar-link active">
                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 13h8V3H3v10Zm0 8h8v-6H3v6Zm10 0h8V11h-8v10Zm0-18v6h8V3h-8Z" />
                    </svg>
                </span>

                <span>Dashboard</span>
            </a>

            <a href="#"
               class="sidebar-link"
               aria-label="Accounts page coming soon">
                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3Zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z" />
                    </svg>
                </span>

                <span>Accounts</span>
            </a>

            <a href="#"
               class="sidebar-link"
               aria-label="New placements page coming soon">
                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6Zm1 7V3.5L18.5 9H15ZM13 12v3h3v2h-3v3h-2v-3H8v-2h3v-3h2Z" />
                    </svg>
                </span>

                <span>New Placements</span>
            </a>

            <a href="#"
               class="sidebar-link"
               aria-label="Documents page coming soon">
                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 4H2v16h20V6H12l-2-2Zm10 14H4V8h16v10Z" />
                    </svg>
                </span>

                <span>Documents</span>
            </a>

            <a href="#"
               class="sidebar-link"
               aria-label="Reports page coming soon">
                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 9.2h3V19H5V9.2ZM10.5 5h3v14h-3V5ZM16 12h3v7h-3v-7Z" />
                    </svg>
                </span>

                <span>Reports</span>
            </a>

            <p class="navigation-label navigation-label-spaced">
                Account
            </p>

            <a href="#"
               class="sidebar-link"
               aria-label="Messages page coming soon">
                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2ZM6 9h12v2H6V9Zm8 5H6v-2h8v2Zm4-6H6V6h12v2Z" />
                    </svg>
                </span>

                <span>Messages</span>

                <span class="sidebar-badge">0</span>
            </a>

            <a href="#"
               class="sidebar-link"
               aria-label="Settings page coming soon">
                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19.43 12.98c.04-.32.07-.65.07-.98s-.03-.66-.08-.98l2.11-1.65-2-3.46-2.49 1a7.24 7.24 0 0 0-1.69-.98L15 3.27h-4l-.38 2.65c-.61.25-1.18.59-1.69.98l-2.49-1-2 3.46 2.11 1.65c-.04.33-.08.66-.08.99s.03.66.08.98l-2.11 1.65 2 3.46 2.49-1c.52.4 1.08.73 1.69.98L11 20.73h4l.38-2.65c.61-.25 1.18-.58 1.69-.98l2.49 1 2-3.46-2.13-1.66ZM13 15.5A3.5 3.5 0 1 1 13 8a3.5 3.5 0 0 1 0 7.5Z" />
                    </svg>
                </span>

                <span>Settings</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="support-card">
                <span class="support-icon">?</span>

                <div>
                    <strong>Need assistance?</strong>
                    <span>Contact your ACP representative.</span>
                </div>
            </div>

            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="logout-button">
                    Sign out
                </button>
            </form>

            <span class="portal-version">
                ACP Client Portal
            </span>
        </div>
    </aside>

    <!-- Main content -->
    <main class="client-main">

        <header class="client-topbar">
            <div class="topbar-left">
                <button class="mobile-menu-button"
                        id="sidebarOpen"
                        type="button"
                        aria-label="Open navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <div>
                    <h1>Client Dashboard</h1>
                    <p>Manage your collection portfolio and account activity.</p>
                </div>
            </div>

            <div class="topbar-actions">
                <button class="notification-button"
                        type="button"
                        aria-label="Notifications">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6v-5a7 7 0 0 0-5-6.71V3.5a2 2 0 0 0-4 0v.79A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z" />
                    </svg>

                    <span class="notification-dot"></span>
                </button>

                <button class="profile-button" type="button">
                    <span class="profile-avatar">AC</span>

                    <span class="profile-details">
                        <strong>@Model.CompanyName</strong>
                        <small>Client Administrator</small>
                    </span>

                    <span class="profile-chevron">⌄</span>
                </button>
            </div>
        </header>

        <div class="dashboard-content">

            <!-- Welcome -->
            <section class="dashboard-welcome">
                <div>
                    <span class="eyebrow">ACCOUNT OVERVIEW</span>
                    <h2>Welcome back</h2>

                    <p>
                        Review your portfolio, submit new accounts, and monitor
                        collection performance from one secure workspace.
                    </p>
                </div>

                <button class="primary-action-button" type="button">
                    <span class="button-plus">+</span>
                    Submit New Accounts
                </button>
            </section>

            <!-- Statistics -->
            <section class="statistics-grid" aria-label="Portfolio summary">

                <article class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 13h8V3H3v10Zm0 8h8v-6H3v6Zm10 0h8V11h-8v10Zm0-18v6h8V3h-8Z" />
                            </svg>
                        </span>

                        <span class="stat-status neutral">Portfolio</span>
                    </div>

                    <span class="stat-label">Total Accounts</span>
                    <strong class="stat-value">0</strong>
                    <span class="stat-description">No accounts submitted yet</span>
                </article>

                <article class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M11 7h2v2h-2V7Zm0 4h2v6h-2v-6Zm1-9a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z" />
                            </svg>
                        </span>

                        <span class="stat-status pending">Pending</span>
                    </div>

                    <span class="stat-label">Active Accounts</span>
                    <strong class="stat-value">0</strong>
                    <span class="stat-description">Accounts currently in recovery</span>
                </article>

                <article class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4Zm1 17h-2v-2h2v2Zm0-4h-2V7h2v7Z" />
                            </svg>
                        </span>

                        <span class="stat-status neutral">Balance</span>
                    </div>

                    <span class="stat-label">Placed Balance</span>
                    <strong class="stat-value">$0.00</strong>
                    <span class="stat-description">Total outstanding placement value</span>
                </article>

                <article class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-icon stat-icon-success">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 17.93V22h-2v-2.07A8 8 0 0 1 4.07 13H2v-2h2.07A8 8 0 0 1 11 4.07V2h2v2.07A8 8 0 0 1 19.93 11H22v2h-2.07A8 8 0 0 1 13 19.93ZM12 6a6 6 0 1 0 0 12 6 6 0 0 0 0-12Zm1 10h-2v-1.2c-1.18-.28-2-1.04-2-2.3h2c0 .5.42.75 1 .75s1-.25 1-.75c0-.45-.3-.65-1.35-.95C10.1 11.1 9 10.48 9 9c0-1.2.82-2.02 2-2.3V6h2v.7c1.18.28 2 1.1 2 2.3h-2c0-.5-.42-.75-1-.75s-1 .25-1 .75c0 .43.32.63 1.35.93C13.9 10.4 15 11.02 15 12.5c0 1.26-.82 2.02-2 2.3V16Z" />
                            </svg>
                        </span>

                        <span class="stat-status success">Recovered</span>
                    </div>

                    <span class="stat-label">Total Recovered</span>
                    <strong class="stat-value">$0.00</strong>
                    <span class="stat-description">Payments recovered to date</span>
                </article>
            </section>

            <!-- Dashboard panels -->
            <section class="dashboard-grid">

                <article class="dashboard-panel accounts-panel">
                    <div class="panel-header">
                        <div>
                            <h3>Recent Accounts</h3>
                            <p>Your most recently submitted collection accounts.</p>
                        </div>

                        <a href="#" class="panel-link">
                            View all
                            <span aria-hidden="true">→</span>
                        </a>
                    </div>

                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6Zm1 7V3.5L18.5 9H15ZM8 13h8v2H8v-2Zm0 4h8v2H8v-2Z" />
                            </svg>
                        </div>

                        <h4>No accounts submitted</h4>

                        <p>
                            Your recently submitted accounts will appear here
                            once you begin placing accounts with ACP.
                        </p>

                        <button class="secondary-action-button" type="button">
                            Submit Your First Account
                        </button>
                    </div>
                </article>

                <aside class="dashboard-panel quick-actions-panel">
                    <div class="panel-header">
                        <div>
                            <h3>Quick Actions</h3>
                            <p>Common client portal tasks.</p>
                        </div>
                    </div>

                    <div class="quick-actions-list">

                        <a href="#" class="quick-action">
                            <span class="quick-action-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6Zm1 7V3.5L18.5 9H15ZM13 12v3h3v2h-3v3h-2v-3H8v-2h3v-3h2Z" />
                                </svg>
                            </span>

                            <span class="quick-action-copy">
                                <strong>Submit accounts</strong>
                                <small>Upload one or multiple placements</small>
                            </span>

                            <span class="quick-action-arrow">›</span>
                        </a>

                        <a href="#" class="quick-action">
                            <span class="quick-action-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2Zm-8 14H7v-5h4v5Zm6 0h-4V7h4v10Z" />
                                </svg>
                            </span>

                            <span class="quick-action-copy">
                                <strong>View reports</strong>
                                <small>Review portfolio performance</small>
                            </span>

                            <span class="quick-action-arrow">›</span>
                        </a>

                        <a href="#" class="quick-action">
                            <span class="quick-action-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M10 4H2v16h20V6H12l-2-2Zm10 14H4V8h16v10Z" />
                                </svg>
                            </span>

                            <span class="quick-action-copy">
                                <strong>Upload documents</strong>
                                <small>Add supporting account files</small>
                            </span>

                            <span class="quick-action-arrow">›</span>
                        </a>

                        <a href="#" class="quick-action">
                            <span class="quick-action-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2ZM6 9h12v2H6V9Zm8 5H6v-2h8v2Zm4-6H6V6h12v2Z" />
                                </svg>
                            </span>

                            <span class="quick-action-copy">
                                <strong>Contact ACP</strong>
                                <small>Send a secure client message</small>
                            </span>

                            <span class="quick-action-arrow">›</span>
                        </a>
                    </div>
                </aside>
            </section>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        (() => {
            const sidebar = document.getElementById("clientSidebar");
            const overlay = document.getElementById("sidebarOverlay");
            const openButton = document.getElementById("sidebarOpen");
            const closeButton = document.getElementById("sidebarClose");

            function openSidebar() {
                sidebar?.classList.add("is-open");
                overlay?.classList.add("is-visible");
                document.body.classList.add("sidebar-open");
            }

            function closeSidebar() {
                sidebar?.classList.remove("is-open");
                overlay?.classList.remove("is-visible");
                document.body.classList.remove("sidebar-open");
            }

            openButton?.addEventListener("click", openSidebar);
            closeButton?.addEventListener("click", closeSidebar);
            overlay?.addEventListener("click", closeSidebar);

            window.addEventListener("resize", () => {
                if (window.innerWidth > 992) {
                    closeSidebar();
                }
            });
        })();
    </script>
}