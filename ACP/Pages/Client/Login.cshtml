@page "/client/login"
@model ACP.Pages.Client.LoginModel
@{
    ViewData["Title"] = "Client Portal Login";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm mt-5">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Client Portal</h1>

                <p class="text-muted mb-4">
                    Sign in to submit and manage collection accounts.
                </p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <input type="hidden"
                           asp-for="ReturnUrl" />

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               placeholder="name@example.com" />

                        <label asp-for="Input.Email"></label>

                        <span asp-validation-for="Input.Email"
                              class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Password" />

                        <label asp-for="Input.Password"></label>

                        <span asp-validation-for="Input.Password"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe"
                               class="form-check-input" />

                        <label asp-for="Input.RememberMe"
                               class="form-check-label"></label>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Sign in to Client Portal
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}